# Groq API Key (Recommended for fast inference)
# Get your token from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Hugging Face API Token (Alternative)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=hf_your_huggingface_token_here

# PostgreSQL Connection String (Required for long-term memory)
# Start Postgres with: docker compose up -d
DATABASE_URL=postgresql://chatbot:chatbot_pass@localhost:5432/chatbot_db
